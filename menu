<!doctype html>
<html lang="es" class="h-full">
 <head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>THE CHICKEN HOUSE - Menú</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body { box-sizing: border-box; }
    .font-display { font-family: 'Bebas Neue', sans-serif; letter-spacing: 1px; }
    .font-body { font-family: 'Poppins', sans-serif; }
    .category-indicator { width: 4px; border-radius: 2px; }
    .menu-item { transition: all 0.3s ease; }
    .menu-item:hover { transform: translateX(4px); }
    .order-item { animation: slideIn 0.3s ease; }
    @keyframes slideIn { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }
    .protein-badge { transition: all 0.2s ease; }
    .protein-badge:hover { transform: scale(1.05); }
    .spice-dot { transition: all 0.2s ease; }
  </style>
 </head>
 <body class="h-full font-body">
  <div id="app-wrapper" class="h-full w-full overflow-auto" style="background-color: #FFED00;">
   <header class="text-center py-8 px-4 border-b-4" style="border-color: #EF2121;">
    <h1 id="restaurant-name" class="font-display text-5xl md:text-6xl font-bold tracking-wide" style="color: #EF2121;">THE CHICKEN HOUSE</h1>
    <p id="tagline" class="font-body text-sm tracking-widest uppercase mt-2 font-semibold" style="color: #1a1a1a;">Pollo asado a la perfección</p>
   </header>

   <div class="flex flex-col lg:flex-row">
    <main class="flex-1 p-6 lg:p-8">
     
     <section class="mb-10">
      <div class="flex items-center gap-3 mb-6">
       <div class="category-indicator h-8" style="background-color: #EF2121;"></div>
       <h2 class="font-display text-3xl font-bold" style="color: #EF2121;">POLLO ASADO CLÁSICO</h2>
      </div>
      <div class="space-y-4">
       <div class="menu-item p-5 rounded-xl cursor-pointer shadow-md" style="background-color: #ffffff; border: 3px solid #EF2121;" onclick="addToOrder('1/2 Pollo Asado', 100, 'pollo-clasico')">
        <div class="flex justify-between items-start">
         <div class="flex-1">
          <h3 class="font-display text-2xl font-bold">1/2 POLLO</h3>
          <p class="text-sm mt-1 font-medium text-gray-500">Sabor tradicional</p>
         </div>
         <div class="text-right ml-4">
          <div class="font-display text-2xl font-bold" style="color: #EF2121;">$100 MXN</div>
          <div class="text-sm font-medium text-gray-500">≈ $5.71 USD</div>
         </div>
        </div>
       </div>

       <div class="menu-item p-5 rounded-xl cursor-pointer shadow-md" style="background-color: #ffffff; border: 3px solid #EF2121;" onclick="addToOrder('1 Pollo Completo', 180, 'pollo-clasico')">
        <div class="flex justify-between items-start">
         <div class="flex-1">
          <h3 class="font-display text-2xl font-bold">1 POLLO COMPLETO</h3>
          <p class="text-sm mt-1 font-medium text-gray-500">Asado a la perfección</p>
         </div>
         <div class="text-right ml-4">
          <div class="font-display text-2xl font-bold" style="color: #EF2121;">$180 MXN</div>
          <div class="text-sm font-medium text-gray-500">≈ $10.28 USD</div>
         </div>
        </div>
       </div>
      </div>
     </section>

     <section class="mb-10">
      <div class="flex items-center gap-3 mb-6">
       <div class="category-indicator h-8" style="background-color: #8B4513;"></div>
       <h2 class="font-display text-3xl font-bold" style="color: #8B4513;">EXTRAS</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
       <div class="menu-item p-4 rounded-xl cursor-pointer shadow-md bg-white border-2" style="border-color: #8B4513;" onclick="addToOrder('Salchicha Asada', 15, 'extra')">
        <div class="flex justify-between items-center">
         <div>
          <h3 class="font-display text-xl font-bold">SALCHICHA ASADA</h3>
          <p class="text-xs text-gray-500">$15 MXN | ≈ $0.85 USD</p>
         </div>
        </div>
       </div>
       <div class="menu-item p-4 rounded-xl cursor-pointer shadow-md bg-white border-2" style="border-color: #8B4513;" onclick="addToOrder('Camote', 30, 'extra')">
        <div class="flex justify-between items-center">
         <div>
          <h3 class="font-display text-xl font-bold">CAMOTE</h3>
          <p class="text-xs text-gray-500">La dulzura que te gusta | $30 MXN</p>
         </div>
         <div class="text-right font-bold" style="color: #8B4513;">$30</div>
        </div>
       </div>
      </div>
     </section>
    </main>

    <aside class="lg:w-80 p-6 lg:sticky lg:top-0 lg:h-screen bg-white border-l-4" style="border-color: #EF2121;">
     <div class="flex items-center justify-between mb-6">
      <h2 class="font-display text-3xl font-bold" style="color: #EF2121;">TU PEDIDO</h2>
      <button onclick="clearOrder()" class="text-xs px-3 py-1 border-2 border-red-600 text-red-600 rounded-full font-bold">Limpiar</button>
     </div>
     <div id="order-items" class="space-y-3 mb-6">
      <p id="empty-order" class="text-sm text-center py-8 text-gray-400 font-medium">Toca un plato para agregarlo</p>
     </div>
     <div id="order-summary" class="hidden border-t-2 pt-4 border-red-600">
      <div class="flex justify-between items-center pt-3">
       <span class="font-display font-bold text-lg">Total (MXN)</span>
       <span id="total" class="font-display text-3xl font-bold text-red-600">$0</span>
      </div>
      <div class="flex justify-between items-center mt-1">
       <span class="text-xs font-medium text-gray-500">Total (USD a 17.50)</span>
       <span id="total-usd" class="text-xl font-bold text-red-600">$0</span>
      </div>
     </div>
    </aside>
   </div>
  </div>

  <script>
    // Configuración global de moneda
    const exchangeRate = 17.5; 
    let orderItems = [];

    function addToOrder(name, priceMXN, category) {
      const categoryColors = {
        'pollo-clasico': '#EF2121',
        'pollo-sabor': '#FF6B00',
        'extra': '#8B4513'
      };

      const existingItem = orderItems.find(item => item.name === name);

      if (existingItem) {
        existingItem.quantity += 1;
      } else {
        orderItems.push({
          name: name,
          priceMXN: priceMXN,
          category: category,
          color: categoryColors[category] || '#333',
          quantity: 1
        });
      }
      renderOrder();
    }

    function removeFromOrder(name) {
      const itemIndex = orderItems.findIndex(item => item.name === name);
      if (itemIndex > -1) {
        if (orderItems[itemIndex].quantity > 1) {
          orderItems[itemIndex].quantity -= 1;
        } else {
          orderItems.splice(itemIndex, 1);
        }
      }
      renderOrder();
    }

    function clearOrder() {
      orderItems = [];
      renderOrder();
    }

    function renderOrder() {
      const container = document.getElementById('order-items');
      const summary = document.getElementById('order-summary');
      
      if (orderItems.length === 0) {
        container.innerHTML = `<p class="text-sm text-center py-8 text-gray-400 font-medium">Vacío</p>`;
        summary.classList.add('hidden');
        return;
      }
      
      summary.classList.remove('hidden');
      container.innerHTML = orderItems.map(item => `
        <div class="order-item flex items-center justify-between p-3 rounded-lg shadow-sm border-2 bg-gray-50" style="border-color: ${item.color};">
          <div class="flex items-center gap-2">
            <span class="font-bold text-red-600">${item.quantity}x</span>
            <div>
              <p class="text-sm font-bold">${item.name}</p>
              <p class="text-xs text-gray-500">$${(item.priceMXN * item.quantity).toFixed(2)} MXN</p>
            </div>
          </div>
          <button onclick="removeFromOrder('${item.name}')" class="text-gray-400 hover:text-red-600 font-bold text-xl">×</button>
        </div>
      `).join('');
      
      const totalMXN = orderItems.reduce((sum, item) => sum + (item.priceMXN * item.quantity), 0);
      const totalUSD = totalMXN / exchangeRate; // Aquí se aplica la conversión de 17.5
      
      document.getElementById('total').textContent = `$${totalMXN.toFixed(2)}`;
      document.getElementById('total-usd').textContent = `$${totalUSD.toFixed(2)}`;
    }
  </script>
 </body>
</html>
